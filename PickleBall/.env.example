# Configuration is read from environment variables (ASP.NET uses "__" as the section separator).
# On Fly.io: `fly secrets set KEY=value`. NEVER commit real values.

ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=postgres;Username=...;Password=...;SSL Mode=Require
# At least 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__SecretKey=
Jwt__Issuer=PickleBallShop
Jwt__Audience=PickleBallShop

Google__ClientId=
Google__ClientSecret=
Google__Gemini__ApiKey=

Email__SmtpUsername=
Email__SmtpPassword=
Email__FromEmail=
Email__FrontendUrl=https://pickleball-shop-frontend.vercel.app

Payment__PayOS__ClientId=
Payment__PayOS__ApiKey=
Payment__PayOS__ChecksumKey=
Payment__MoMo__PartnerCode=
Payment__MoMo__AccessKey=
Payment__MoMo__SecretKey=
Payment__VNPay__TmnCode=
Payment__VNPay__HashSecret=

# Comma separated extra CORS origins (preview deployments etc.)
FRONTEND_URL=https://pickleball-shop-frontend.vercel.app
Cors__AllowedOrigins__0=https://pickleball-shop-frontend.vercel.app

# Optional: bootstrap the first admin. Both must be set; password must meet the password policy.
# The account is only created if no admin exists yet. Remove these variables afterwards.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Trust X-Forwarded-* only from loopback/private proxy ranges (Fly.io: keep true).
# Extra proxy IPs can be added with Security__TrustedProxies__0=<ip> (see Program.cs).
Security__TrustProxyHeaders=true

