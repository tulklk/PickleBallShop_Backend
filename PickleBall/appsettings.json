{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "https://pickleball-shop-frontend.vercel.app",
      "https://techstorefe.azurewebsites.net"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Server=YOUR_DB_HOST;Port=5432;Database=postgres"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "PickleBallShop",
    "Audience": "PickleBallShop",
    "ExpiryMinutes": "60"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "Gemini": {
      "ApiKey": "YOUR_GEMINI_API_KEY",
      "ModelName": "gemini-2.5-flash"
    }
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "YOUR_EMAIL",
    "SmtpPassword": "YOUR_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL",
    "FromName": "IKA PickleBall Shop",
    "EnableSsl": true,
    "FrontendUrl": "https://your-frontend-url.com"
  },
  "Payment": {
    "MoMo": {
      "PartnerCode": "MOMO_PARTNER_CODE",
      "AccessKey": "MOMO_ACCESS_KEY",
      "SecretKey": "MOMO_SECRET_KEY",
      "Endpoint": "https://test-payment.momo.vn/v2/gateway/api/create",
      "ReturnUrl": "https://your-domain.com/api/payments/momo/return",
      "IpnUrl": "https://your-domain.com/api/payments/momo/ipn"
    },
    "VNPay": {
      "TmnCode": "VNPAY_TMN_CODE",
      "HashSecret": "VNPAY_HASH_SECRET",
      "Endpoint": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
      "ReturnUrl": "https://your-domain.com/api/payments/vnpay/return",
      "IpnUrl": "https://your-domain.com/api/payments/vnpay/ipn"
    },
    "PayOS": {
      "ClientId": "YOUR_PAYOS_CLIENT_ID",
      "ApiKey": "YOUR_PAYOS_API_KEY",
      "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY"
    }
  }
}
