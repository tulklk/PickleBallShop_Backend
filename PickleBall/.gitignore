# Environment variables
.env
.env.local
.env.*.local

# User secrets (Windows)
secrets.json

# App settings với sensitive data (chỉ ignore bản override theo môi trường)
appsettings.Development.json
appsettings.Production.json
appsettings.*.json
!appsettings.Example.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

